generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Lifecycle of a delivery, per CLAUDE.md. Later features move an order
// through the remaining states; create order only ever sets the default.
enum OrderStatus {
  pending_confirmation
  confirmed
  not_ready
  dispatched
  delivered
  failed
}

model Rider {
  id     String  @id @default(cuid())
  name   String
  phone  String
  orders Order[]
}

model Order {
  id              String      @id @default(cuid())
  customerName    String
  customerPhone   String
  itemDescription String
  riderId         String
  rider           Rider       @relation(fields: [riderId], references: [id])
  status          OrderStatus @default(pending_confirmation)
  createdAt       DateTime    @default(now())

  // Random, non-sequential token for the customer's link, so links can't be
  // enumerated by editing the id. Generated by Postgres (122 random bits).
  customerToken String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Where the customer said to find them (MVP feature 3). All set together
  // once the customer confirms and drops their pin; null until then.
  lat             Float?
  lng             Float?
  landmarkNote    String?
  locationSavedAt DateTime?

  @@index([riderId])
}

// The last pin a customer shared, so it loads automatically on their next
// order. Keyed by normalized phone number (see src/lib/phone.ts).
model SavedLocation {
  phoneKey     String   @id
  lat          Float
  lng          Float
  landmarkNote String
  updatedAt    DateTime @updatedAt
}
