generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Lifecycle of a delivery, per CLAUDE.md. Later features move an order
// through the remaining states; create order only ever sets the default.
enum OrderStatus {
  pending_confirmation
  confirmed
  not_ready
  dispatched
  delivered
  failed
}

// Preset reasons a rider can give for a failed delivery. Free-text notes
// are deferred (CLAUDE.md).
enum FailureReason {
  customer_not_ready
  address_not_found
  customer_unreachable
  other
}

// Who confirmed the customer got their items: the customer themselves
// ("I've received my delivery"), or the vendor on their behalf when the
// customer couldn't (CLAUDE.md flow step 6).
enum DeliveryConfirmer {
  customer
  vendor
}

enum Vehicle {
  bike
  car
  van
}

model Rider {
  id      String   @id @default(cuid())
  name    String
  phone   String
  vehicle Vehicle?
  orders  Order[]
}

model Order {
  id              String      @id @default(cuid())
  // Short number the vendor sees ("Order #12"). Internal only: public links
  // use customerToken, never this or id.
  orderNumber     Int         @unique @default(autoincrement())
  customerName    String
  customerPhone   String
  itemDescription String
  riderId         String
  rider           Rider       @relation(fields: [riderId], references: [id])
  status          OrderStatus @default(pending_confirmation)
  createdAt       DateTime    @default(now())
  // Bumped by Prisma on every write (any status change). Drives the
  // dashboard's "most recent first" sort.
  updatedAt       DateTime    @updatedAt

  // Random, non-sequential token for the customer's link, so links can't be
  // enumerated by editing the id. Generated by Postgres (122 random bits).
  customerToken String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Where the customer said to find them (MVP feature 3). All set together
  // once the customer confirms and drops their pin; null until then.
  lat             Float?
  lng             Float?
  landmarkNote    String?
  locationSavedAt DateTime?

  // Token for the rider's link (MVP feature 4), random like customerToken.
  // The API only hands it out once the customer's pin is saved.
  riderToken String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // A timestamp per status transition, so the full timeline can be shown
  // (Vendor: On Its Way progress list) without guessing from `status` alone.
  confirmedAt         DateTime? // when the customer tapped "I'm ready" (or, later, "Actually, I'm ready")
  notReadyAt          DateTime? // when the customer tapped "Not now"
  dispatchedAt        DateTime? // when the vendor sent the rider link
  pickedUpAt          DateTime? // when the rider confirmed they collected the order
  receivedAt          DateTime? // when the customer tapped "I've received my delivery"
  completedAt         DateTime? // when the delivery was completed or marked failed
  failureReason       FailureReason?
  deliveryConfirmedBy DeliveryConfirmer?

  @@index([riderId])
}

// The last pin a customer shared, so it loads automatically on their next
// order. Keyed by normalized phone number (see src/lib/phone.ts).
model SavedLocation {
  phoneKey     String   @id
  lat          Float
  lng          Float
  landmarkNote String
  updatedAt    DateTime @updatedAt
}
