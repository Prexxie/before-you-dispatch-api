generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Lifecycle of a delivery, per CLAUDE.md. Later features move an order
// through the remaining states; create order only ever sets the default.
enum OrderStatus {
  pending_confirmation
  confirmed
  not_ready
  dispatched
  delivered
  failed
}

model Rider {
  id     String  @id @default(cuid())
  name   String
  phone  String
  orders Order[]
}

model Order {
  id              String      @id @default(cuid())
  customerName    String
  customerPhone   String
  itemDescription String
  riderId         String
  rider           Rider       @relation(fields: [riderId], references: [id])
  status          OrderStatus @default(pending_confirmation)
  createdAt       DateTime    @default(now())

  // Random, non-sequential token for the customer's link, so links can't be
  // enumerated by editing the id. Generated by Postgres (122 random bits).
  customerToken String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@index([riderId])
}
