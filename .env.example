# Port the API listens on
PORT=4000

# Frontend origin allowed by CORS (comma-separate multiple origins)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string (Supabase: use the Session pooler string,
# port 5432 — the direct connection is IPv6-only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Termii SMS gateway API key
TERMII_API_KEY=

# Signs the vendor session cookie. Required in production — generate with
# `openssl rand -base64 32`. Locally, an insecure default is used if this is
# left empty.
JWT_SECRET=

# Password-reset emails, sent through Brevo (brevo.com) over HTTPS, so it
# works on Render/Railway too. Leave EMAIL_API_KEY empty locally: the reset
# link is printed in the API console instead.
# EMAIL_FROM must be a sender you've verified in Brevo (Senders, Domains &
# Dedicated IPs > Senders): "you@example.com" or "Before You Dispatch <you@example.com>".
EMAIL_API_KEY=
EMAIL_FROM=

# Public URL of the web app, used for links inside emails.
WEB_URL=http://localhost:3000

# Google sign-in. The OAuth *Client ID* from Google Cloud (ends in
# .apps.googleusercontent.com). Not the client secret: this flow doesn't use
# it. Leave empty to turn Google sign-in off. The web app needs the same value
# as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
