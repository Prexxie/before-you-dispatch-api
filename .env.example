# Port the API listens on
PORT=4000

# Frontend origin allowed by CORS (comma-separate multiple origins)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string (Supabase: use the Session pooler string,
# port 5432 — the direct connection is IPv6-only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Termii SMS gateway API key
TERMII_API_KEY=

# Signs the vendor session cookie. Required in production — generate with
# `openssl rand -base64 32`. Locally, an insecure default is used if this is
# left empty.
JWT_SECRET=
