# Port the API listens on
PORT=4000

# Frontend origin allowed by CORS (comma-separate multiple origins)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string (Supabase: use the Session pooler string,
# port 5432 — the direct connection is IPv6-only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Termii SMS gateway API key
TERMII_API_KEY=

# The business shown to customers and riders (messages and pages) until
# vendor accounts exist. Optional; leave the name empty to hide all three.
DEMO_VENDOR_NAME=Precious Food Business
DEMO_VENDOR_ADDRESS=12 Allen Avenue, Ikeja
DEMO_VENDOR_PHONE=0803 214 7765
